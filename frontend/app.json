{
  "expo": {
    "name": "Elvyn",
    "slug": "change",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/02_app_icon_color.png",
    "scheme": "elvyn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/02_app_icon_color.png",
      "bundleIdentifier": "com.ktlabs.elvyn"
    },
    "android": {
      "package": "com.kunletech.change",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F5F7FC",
        "foregroundImage": "./assets/branding/02_app_icon_color_transparent.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/branding/02_app_icon_color.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9FAFD",
          "image": "./assets/branding/01_primary_stacked_logo_transparent.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#0B0A1F",
            "image": "./assets/branding/01_primary_stacked_logo_dark.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      "./plugins/withNotificationManifestFix.js",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Change to use the microphone for voice capture in Brain Dump.",
          "speechRecognitionPermission": "Allow Change to use speech recognition to transcribe your Brain Dump."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      "expo-status-bar"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d401dd85-2e8f-472b-a212-7ab9c0ec90d5"
      }
    }
  }
}
